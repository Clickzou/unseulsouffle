# Copier en .env.local (local) et renseigner aussi dans Vercel (production).

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Destinataire des demandes du formulaire de contact
CONTACT_TO=contact@unseulsouffle.fr

# Expéditeur : le domaine doit être vérifié dans Resend (Domains)
CONTACT_FROM=Un Seul Souffle <site@unseulsouffle.fr>

# Google Analytics 4 — identifiant de mesure (G-XXXXXXXXXX).
# Chargé uniquement après accord dans le bandeau cookies.
NEXT_PUBLIC_GA_ID=

# Google Search Console — contenu de la balise meta de validation
# (valeur de content="..." dans la méthode « Balise HTML »).
NEXT_PUBLIC_GSC_VERIFICATION=

# Affiche les articles programmés avant leur date, pour la relecture.
# Local ou « Preview » Vercel uniquement ; ignoré en production.
APERCU_BROUILLONS=

# E-mail de contrôle envoyé le vendredi avant chaque publication d'article.
# CRON_SECRET : chaîne aléatoire, Vercel l'envoie au cron (Settings > Environment Variables).
CRON_SECRET=
# Destinataire(s), séparés par des virgules.
ALERTE_PUBLICATION_TO=
# Expéditeur de cet e-mail (facultatif, sinon CONTACT_FROM). Domaine vérifié dans Resend.
ALERTE_FROM=
