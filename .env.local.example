# Copier en .env.local (local) et renseigner aussi dans Vercel (production).

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Destinataire des demandes du formulaire de contact
CONTACT_TO=contact@unseulsouffle.fr

# Expéditeur : le domaine doit être vérifié dans Resend (Domains)
CONTACT_FROM=Un Seul Souffle <site@unseulsouffle.fr>
